# ----------------------------------------------------------------------
# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# the token. Docker Compose reads `.env` automatically -- no flags needed.
#
#   Windows PowerShell:   Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
# ----------------------------------------------------------------------

# Hugging Face access token -- https://huggingface.co/settings/tokens
#
# Needed ONLY for the one-time model download. The IndicTrans2 translation
# checkpoints are gated repos, so an anonymous download of them fails.
# The account this token belongs to must have accepted access on each model
# page first (see DOCKER.md) -- the token is proof of that acceptance, not a
# way around it.
#
# Use a fine-grained, read-only token. Anything pushed to a public GitHub
# repo gets detected and revoked automatically, which is exactly why this
# lives in `.env` (gitignored) rather than in a tracked file.
HF_TOKEN=

# ----------------------------------------------------------------------
# Optional settings -- the defaults are fine for most machines.
# ----------------------------------------------------------------------

# Port on your machine. Change if something already uses 8000.
BAIF_HOST_PORT=8000

# faster-whisper model size: medium (default, best quality) | small | base.
# small/base are dramatically faster on a CPU-only machine.
BAIF_ASR_MODEL=medium

# 1 = also download Indic Parler-TTS (several GB, separately gated) to
# enable the audio-dubbing bonus feature.
BAIF_INCLUDE_TTS=0
