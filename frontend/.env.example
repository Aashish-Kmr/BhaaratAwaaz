# Copy to .env.local and adjust.

# true  -> in-memory fake backend (default, no server needed)
# false -> talk to the real local backend
VITE_USE_MOCK=true

# Where the frontend sends API calls at runtime.
VITE_API_BASE=/api

# Where the dev server proxies /api and /media (build-time only).
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
